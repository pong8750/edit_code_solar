void loop() {
  static bool clearDone1 = false;
  static bool clearDone2 = false;
  static unsigned long lastLcdBlink = 0;
  static unsigned long lastWifiTry = 0;
  static unsigned long lastMsg = 0;          
  static bool lastManualState = false;       

  if (WiFi.status()!= WL_CONNECTED && millis() - lastWifiTry > 10000) {
    lastWifiTry = millis();
    WiFi.begin(ssid, password);
    Serial.println(">>> [NET]: Retry WiFi <<<");
    lcd.clear();
  }

  if (!client.connected()) {
    clearDone1 = false;
    reconnect();
  } else if (!clearDone1) {
    client.publish("saraphi/cmd/reboot", "0", true);
    delay(50);
    client.publish("saraphi/cmd/reboot", NULL, true);
    clearDone1 = true;
    Serial.println(">>> [LOOP]: Cleared retained reboot on server1 <<<");
    lcd.setCursor(17,2);
    lcd.printf("M1");
  }

  if (!client2.connected()) {
    clearDone2 = false;
    reconnect();
  } else if (!clearDone2) {
    client2.publish("saraphi/cmd/reboot", "0", true);
    delay(50);
    client2.publish("saraphi/cmd/reboot", NULL, true);
    clearDone2 = true;
    Serial.println(">>> [LOOP]: Cleared retained reboot on server2 <<<");
    lcd.setCursor(19,2);
    lcd.printf("2 ");
  }

  client.loop();
  client2.loop();

  DateTime now = rtc.now();
  handleTimeSetting();

  if (editState == 0) {
    checkManualButton();
    readSensors();
    handleMagDC_220V();

    if (millis() - lastLcdBlink > 500) {
      lastLcdBlink = millis();
      lcd.setCursor(11,2);
      if (WiFi.status()!= WL_CONNECTED) {
        lcd.printf("WIFILOST    ");
        Serial.println(">>WIFI-LOST<<");
      } else if (!client.connected() &&!client2.connected()) {
        lcd.setCursor(15,2);
        lcd.printf("MQOK");
        Serial.println("MQOK");
      } else {
        lcd.setCursor(11,2);
        lcd.printf("NETOK ");
      }
    }

    if (manualState == true) {
      if (lastManualState == false) {
        lcd.clear();
        lastManualState = true;
      }
      lcd.setCursor(0,1);
      lcd.printf("MODE: MANUAL      ");
      lcd.setCursor(0,2);
      lcd.printf("USE : %s ", gridMode? "PEA (GRID)" : "INVERTER ");
    } else {
      if (lastManualState == true) {
        lcd.clear();
        lastManualState = false;
      }
      
      // เรียกฟังก์ชันคำนวณเวลาและโวลต์ (อัปเดตค่า nextMode)
      runAutoSystem();
 
      lcd.setCursor(0,0);
      lcd.setCursor(0,1);
      lcd.printf("CT%.1fA  %02d:%02d:%02d ", currentAC, now.hour(), now.minute(), now.second());

      Serial.printf("36:INV=v1:%.1f, 39:BATT=v2:%.1f, 34:PEA=v3:%.1f, 33:CT:AC:%.1fA, 32:TEMP:%.1f, :%02d:%02d:%02d\n", 
              v1, v2, v3, currentAC, tempNTC, now.hour(), now.minute(), now.second()); 

      lcd.setCursor(0,2); 
      lcd.printf("INV:%.1fV ", v1);
      lcd.setCursor(0,3);
      lcd.printf("PEA:%.1fV BAT%.1fV", v3, v2);
      
      if (manualState == false) {
          lcd.setCursor(0,0);
          lcd.print("AUTO");
      }
    }
  }

  if (millis() - lastMsg >= 900) {
    lastMsg = millis();
    String gStat = gridMode? "PEA" : "INV";
    char timeBuf[10];
    sprintf(timeBuf, "%02d:%02d:%02d", now.hour(), now.minute(), now.second());

    if (client.connected()) {
      client.publish("saraphi/inv/v1", String(v1, 1).c_str());
      client.publish("saraphi/vbat/v2", String(v2, 1).c_str());
      client.publish("saraphi/vpia/v3", String(v3, 1).c_str());
      client.publish("saraphi/temp/ntc", String(tempNTC, 1).c_str());
      client.publish("saraphi/current/ac", String(currentAC, 1).c_str());
      client.publish("saraphi/status/grid", gStat.c_str());
      client.publish("saraphi/status/boost", magConnected? "ON" : "OFF");
      client.publish("saraphi/status/time", timeBuf);
    }
    if (client2.connected()) {
      client2.publish("saraphi/inv/v1", String(v1, 1).c_str());
      client2.publish("saraphi/vbat/v2", String(v2, 1).c_str());
      client2.publish("saraphi/vpia/v3", String(v3, 1).c_str());
      client2.publish("saraphi/temp/ntc", String(tempNTC, 1).c_str());
      client2.publish("saraphi/current/ac", String(currentAC, 1).c_str());
      client2.publish("saraphi/status/grid", gStat.c_str());
      client2.publish("saraphi/status/boost", magConnected? "ON" : "OFF");
      client2.publish("saraphi/status/time", timeBuf);
    }
  }

  delay(100);
  view_value2();
  delay(100);
  view_value();

  if (millis() - lastRTCPing > 10000) {
    lastRTCPing = millis();
    publishRTCTime();
    publishTimeStatus();
    publishMULV123();
  }

  // ==================== [ศูนย์รวมการสลับไฟระบบออโต้จุดเดียวจบ] ====================
    // ==================== [ศูนย์รวมการสลับไฟระบบออโต้จุดเดียวจบ - ฉบับแก้ไขอาการรัว] ====================
  if (manualState == false) { 
    
    // คำนวณกระแสสดจากเซนเซอร์ใหม่อีกครั้งเพื่อความแม่นยำสูงสุด
    float acAmp = readCurrentAC(); 

    // คำนวณตรรกะเวลาข้ามคืน
    long startSec = startHH * 3600L + startMN * 60L;
    long stopSec = stopHH * 3600L + stopMN * 60L;
    long nowSec = now.hour() * 3600L + now.minute() * 60L + now.second();
    bool inPeriod = (startSec <= stopSec) ? (nowSec >= startSec && nowSec < stopSec) : (nowSec >= startSec || nowSec < stopSec);

    // 1. ถ้ากระแสโหลดเกิน 18A บังคับดีดไป PEA ทันที และเริ่มคูลดาวน์ล็อกระบบ 5 นาที
    if (acAmp > 18.0 && breakerState == false) {
      Serial.println(">>> [CRITICAL]: OVERLOAD > 18A! SLAM TO PEA <<<");
      nextMode = true;
      isCooldown = true;
      cooldownStart = millis();
    }

    // 2. ตรวจสอบเงื่อนไขการสลับกลับ Inverter (เปลี่ยนมาใช้ acAmp เพื่อแก้บั๊กรัว)
    if (v1 > vHighLimit && acAmp < 11.3 && isCooldown == false && inPeriod == true) {
       nextMode = false; 
    } else {
       if (v1 < vLowLimit || !inPeriod || isCooldown == true || acAmp > 18.0) {
          nextMode = true; 
       }
    }

    // 3. 🎯 ตัวขับขี่ทางกายภาพ (คำสั่งเขียนทับพินจริงที่ปลายลูป พร้อมหน่วงเวลาป้องกันสับรัว)
    static unsigned long lastSwitchTime = 0;
    if (millis() - lastSwitchTime > 2000) { // ล็อกระบบเพิ่ม: ห้ามคอนแทกเตอร์สับเปลี่ยนบ่อยเกินทุกๆ 2 วินาที
      if (nextMode == false) {
        if (digitalRead(PIN_INV) == LOW) {
          digitalWrite(PIN_PEA, LOW);   
          delay(50); // เพิ่มเวลาหน่วงป้องกันหน้าสัมผัสอาร์กชนกันข้ามเฟส                  
          digitalWrite(PIN_INV, HIGH);  
          gridMode = false;            
          breakerState = false;         
          lastSwitchTime = millis();
          Serial.println(">>> [HARDWARE]: RE-ENFORCE INVERTER OUTPUT <<<");
        }
      } else {
        if (digitalRead(PIN_PEA) == LOW) {
          digitalWrite(PIN_INV, LOW);   
          delay(50);                   
          digitalWrite(PIN_PEA, HIGH);  
          gridMode = true;             
          breakerState = true;          
          lastSwitchTime = millis();
          Serial.println(">>> [HARDWARE]: RE-ENFORCE PEA OUTPUT <<<");
        }
      }
    }
  }

  // --- พิน 16 ส่งสถานะ MQTT ---
  static unsigned long lastPub = 0;
  if (millis() - lastPub > 1000) {
    lastPub = millis();
    const char* st = digitalRead(PIN_BOOST) ? "ON" : "OFF";
    if (client.connected()) client.publish("saraphi/status/boost2", st, true);
    if (client2.connected()) client2.publish("saraphi/status/boost2", st, true);
  }
} // ปิดฟังก์ชัน void loop()
