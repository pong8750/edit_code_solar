void runAutoSystem() {
  unsigned long currentMillis = millis();
  DateTime now = rtc.now();

  long startSec = startHH * 3600L + startMN * 60L;
  long stopSec = stopHH * 3600L + stopMN * 60L;
  long nowSec = now.hour() * 3600L + now.minute() * 60L + now.second();

  static unsigned long stableStart = 0;
  static bool isWaitingStable = false;
  static bool firstRun = true; // เพิ่มใหม่: ตัวแปรเช็กจังหวะเปิดเครื่องครั้งแรก

  float acAmp = readCurrentAC(); 

  // --- เงื่อนไขด่วน: กระแสเกิน 18A ตัดหน้าเข้า PEA ทันที และเริ่มคูลดาวน์ 5 นาที ---
  if (acAmp > 18.0 && breakerState == false) {
    Serial.println(">>> [WARN]: CURRENT OVERLOAD! SLAM TO PEA & START 5 MIN COOLDOWN <<<");
    nextMode = true;
    isCooldown = true;
    isWaitingStable = false;
    firstRun = false; // หลุดจากสถานะเปิดเครื่องครั้งแรก
    cooldownStart = currentMillis;
    return; 
  }

  // 1. ตรวจสอบช่วงเวลาทำงาน (ข้ามวันข้ามคืน)
  bool inPeriod = false;
  if (startSec <= stopSec) {
    if (nowSec >= startSec && nowSec < stopSec) inPeriod = true;
  } else {
    if (nowSec >= startSec || nowSec < stopSec) inPeriod = true;
  }

  if (!inPeriod) {
    nextMode = true;     
    isCooldown = false;  
    isWaitingStable = false;
    firstRun = false;
    confirmCount = 0;
    return;
  }

  // 2. อยู่ในช่วงเวลาทำงาน -> ตรวจสอบระบบ Cooldown ขาตก (5 นาที)
  if (isCooldown) {
    if (currentMillis - cooldownStart >= 300000) { 
      isCooldown = false;
      isWaitingStable = false; 
      Serial.println(">>> [INFO]: COOLDOWN FINISHED! ENTERING WATCH MODE <<<");
    } else {
      nextMode = true; 
      if (currentMillis % 3000 < 50) {
        float remainMin = (300000 - (currentMillis - cooldownStart)) / 60000.0;
        Serial.printf(">>> [STATUS]: COOLDOWN REMAIN: %.1f MIN <<<\n", remainMin);
      }
      return;
    }
  } 

  // 3. ปลดคูลดาวน์แล้ว -> ตรวจสอบการสลับกลับ Inverter
  if (v1 < vLowLimit) {
    nextMode = true;
    isCooldown = true;
    isWaitingStable = false;
    firstRun = false;
    cooldownStart = currentMillis;
    Serial.println(">>> [EVENT]: V1 DROP! RE-START 5 MIN COOLDOWN <<<");
  } 
  else if (v1 > vHighLimit && acAmp < 11.3) { 
    
    // แก้ไขจุดนี้: ถ้าเปิดเครื่องมาครั้งแรกแล้วไฟดีอยู่แล้ว ให้เข้า Inverter ทันที ไม่ต้องรอเฝ้าดู 5 นาที
    if (firstRun) {
      nextMode = false; 
      isWaitingStable = false;
      firstRun = false;
      Serial.println(">>> [SYSTEM]: FIRST RUN & SYSTEM OK! INITIAL TO INVERTER <<<");
    } 
    // กรณีปกติหลังจากระบบเคยตัดไป PEA แล้วแรงดันฟื้นกลับมา ถึงค่อยเข้าสู่โหมดเฝ้าดู 5 นาที
    else if (!isWaitingStable) {
      isWaitingStable = true;
      stableStart = currentMillis;
      Serial.println(">>> [HYSTERESIS]: CONDITIONS OK! WATCHING FOR 5 MINS TO STABLE <<<");
    } else {
      if (currentMillis - stableStart >= 300000) { 
        nextMode = false; 
        isWaitingStable = false;
        confirmCount = 0;
        Serial.println(">>> [SUCCESS]: STABLE FOR 5 MINS! SWITCH BACK TO INV <<<");
      } else {
        nextMode = true; // ระหว่างเฝ้าดู ล็อกไว้ที่ PEA ก่อน
        if (currentMillis % 3000 < 50) {
          float stableRemain = (300000 - (currentMillis - stableStart)) / 60000.0;
          Serial.printf(">>> [STATUS]: WATCHING STABLE REMAIN: %.1f MIN <<<\n", stableRemain);
        }
      }
    }
  } 
  else {
    if (isWaitingStable) {
      isWaitingStable = false;
      nextMode = true;
      Serial.println(">>> [WARN]: V1 OR LOAD FLUCTUATED! CANCEL STABLE TIMER <<<");
    }
  }
}


