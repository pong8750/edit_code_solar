void callback(char* topic, byte* payload, unsigned int length) {
  String msg = "";
  for (int i = 0; i < length; i++) {
    msg += (char)payload[i];
  }

  float newVal = msg.toFloat();
  Serial.printf("MQTT Recv Topic: %s, Msg: %s\n", topic, msg.c_str());

  // 1. จูนค่า V1/V2/V3/VLow/VHigh
  if (String(topic).indexOf("saraphi/set/v") >= 0) {
    if (newVal > 0) {
      if (String(topic) == "saraphi/set/v1") { MULT_V1 = newVal; }
      else if (String(topic) == "saraphi/set/v2") { MULT_V2 = newVal; }
      else if (String(topic) == "saraphi/set/v3") { MULT_V3 = newVal; }
      else if (String(topic) == "saraphi/set/v1_low") { vLowLimit = newVal; }
      else if (String(topic) == "saraphi/set/v1_high") { vHighLimit = newVal; }

      // เขียนลง NVS ทีเดียว
      prefs.begin("solar_cal", false);
      prefs.putFloat("v1_cal", MULT_V1);
      prefs.putFloat("v2_cal", MULT_V2);
      prefs.putFloat("v3_cal", MULT_V3);
      prefs.putFloat("vLow", vLowLimit);
      prefs.putFloat("vHigh", vHighLimit);
      prefs.end();
      delay(50);

      Serial.printf(">>> SAVED ALL: V1=%.1f V2=%.1f V3=%.1f Low=%.1f High=%.1f\n", MULT_V1, MULT_V2, MULT_V3, vLowLimit, vHighLimit);
      readSensors();
      publishTimeStatus();
    }
    return;
  }

  // 2. <<< เพิ่มใหม่: รับเวลาจาก Node-RED "09:30" >>>
  if (String(topic) == "saraphi/set/time_start") {
    int h = msg.substring(0, 2).toInt();
    int m = msg.substring(3, 5).toInt();
    if (h >= 0 && h < 24 && m >= 0 && m < 60) {
      startHH = h;
      startMN = m;
      prefs.begin("solar_cal", false);
      prefs.putInt("sHH", startHH);
      prefs.putInt("sMN", startMN);
      prefs.end();
      delay(50);
      Serial.printf(">>> SAVED TIME START: %02d:%02d\n", startHH, startMN);
    }
    return;
  }

  if (String(topic) == "saraphi/set/time_stop") {
    int h = msg.substring(0, 2).toInt();
    int m = msg.substring(3, 5).toInt();
    if (h >= 0 && h < 24 && m >= 0 && m < 60) {
      stopHH = h;
      stopMN = m;
      prefs.begin("solar_cal", false);
      prefs.putInt("tHH", stopHH);
      prefs.putInt("tMN", stopMN);
      prefs.end();
      delay(50);
      Serial.printf(">>> SAVED TIME STOP: %02d:%02d\n", stopHH, stopMN);
      publishTimeStatus();
    }
    return;
  }

// <<< วางตรงนี้เลย ต่อจาก time_stop >>>
if (String(topic) == "saraphi/set/ntc_offset") {
  NTC_OFFSET = newVal;
  prefs.begin("solar_cal", false);
  prefs.putFloat("ntc_off", NTC_OFFSET);
  prefs.end();
  Serial.printf(">>> SAVED NTC_OFFSET: %.1f\n", NTC_OFFSET);
  return;
}


  // 3. คำสั่ง Reboot
  if (String(topic) == "saraphi/cmd/reboot" && msg == "1") {
    lcd.clear();
    lcd.setCursor(0, 0); lcd.print("MQTT REBOOT CMD");
    delay(3000);
    ESP.restart();
  }

  // 4. คำสั่ง Manual INV/PEA/AUTO
  else if (String(topic) == "saraphi/cmd/manual") {
    if (msg == "INV") {
      manualState = true; isCooldown = false;
      digitalWrite(PIN_PEA, LOW); delay(15); digitalWrite(PIN_INV, HIGH);
      gridMode = false;
/*
      //เพิ่มให้ อ่าน ค่าแรงดัน ได้ ที่นี่
      readSensors();
      
      lcd2.setCursor(0,0);
      lcd2.printf("     INV:%.1f ", v1);
      lcd2.setCursor(0,1);
      lcd2.printf("B%.1fV PEA:%.1f ",v2,v3);
      */
    }
    else if (msg == "PEA") {
      manualState = true; isCooldown = false;
      digitalWrite(PIN_INV, LOW); delay(15); digitalWrite(PIN_PEA, HIGH);
      gridMode = true;
    }
    else if (msg == "AUTO") { manualState = false; }
    showmode();
  }
}

